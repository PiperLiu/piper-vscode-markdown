        "title": "%piperMarkdown.enhanced.openCurrentSourceInEditorAndClosePreview.title%"
      },
      {
        "command": "piperMarkdown.enhanced.toggleScrollSync",
        "title": "%piperMarkdown.enhanced.toggleScrollSync.title%"
      },
      {
        "command": "piperMarkdown.enhanced.toggleLiveUpdate",
        "title": "%piperMarkdown.enhanced.toggleLiveUpdate.title%"
      },
      {
        "command": "piperMarkdown.enhanced.toggleBreakOnSingleNewLine",
        "title": "%piperMarkdown.enhanced.toggleBreakOnSingleNewLine.title%"
      },
      {
        "command": "piperMarkdown.enhanced.openImageHelper",
        "title": "%piperMarkdown.enhanced.openImageHelper.title%"
