        "piperMarkdown.enhanced.mathjaxScriptSrc": {
          "description": "%piperMarkdown.enhanced.mathjaxScriptSrc.description%",
          "default": "https://cdn.jsdelivr.net/npm/mathjax@4/tex-mml-chtml.js",
          "type": "string"
        },
        "piperMarkdown.enhanced.mathjaxV3ScriptSrc": {
          "markdownDeprecationMessage": "This setting has been renamed to `#piperMarkdown.enhanced.mathjaxScriptSrc#` and the default now loads MathJax v4. Please move your value to the new setting.",
