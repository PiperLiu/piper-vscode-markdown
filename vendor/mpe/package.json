        "title": "%piperMarkdown.enhanced.copyCurrentSourceRelativePath.title%"
      },
      {
        "command": "piperMarkdown.enhanced.copyCurrentSourcePath",
        "title": "%piperMarkdown.enhanced.copyCurrentSourcePath.title%"
      },
