    "configuration": {
      "type": "object",
      "title": "Markdown Preview Enhanced",
      "properties": {
        "piperMarkdown.enhanced.crossnoteServePort": {
          "description": "%piperMarkdown.enhanced.crossnoteServePort.description%",
          "default": 3000,
          "type": "number",
          "minimum": 0,
          "maximum": 65535
        },
        "piperMarkdown.enhanced.configPath": {
          "markdownDescription": "%piperMarkdown.enhanced.configPath.markdownDescription%",
          "default": "",
          "type": "string",
          "scope": "machine"
        },
        "piperMarkdown.enhanced.markdownParser": {
          "description": "%piperMarkdown.enhanced.markdownParser.description%",
          "default": "markdown-it",
          "type": "string",
          "enum": [
            "markdown-it",
            "pandoc",
            "markdown_yo"
          ],
          "enumDescriptions": [
            "%piperMarkdown.enhanced.markdownParser.enumDescriptions.0%",
            "%piperMarkdown.enhanced.markdownParser.enumDescriptions.1%",
            "%piperMarkdown.enhanced.markdownParser.enumDescriptions.2%"
          ]
        },
        "piperMarkdown.enhanced.breakOnSingleNewLine": {
          "description": "%piperMarkdown.enhanced.breakOnSingleNewLine.description%",
          "default": true,
          "type": "boolean"
        },
        "piperMarkdown.enhanced.scrollSync": {
          "description": "%piperMarkdown.enhanced.scrollSync.description%",
          "default": true,
          "type": "boolean"
        },
        "piperMarkdown.enhanced.liveUpdate": {
          "description": "%piperMarkdown.enhanced.liveUpdate.description%",
          "default": true,
          "type": "boolean"
        },
        "piperMarkdown.enhanced.liveUpdateDebounceMs": {
          "description": "%piperMarkdown.enhanced.liveUpdateDebounceMs.description%",
          "default": 300,
          "type": "number",
          "minimum": 0,
          "maximum": 5000
        },
        "piperMarkdown.enhanced.previewMode": {
          "markdownDescription": "%piperMarkdown.enhanced.previewMode.markdownDescription%",
          "type": "string",
          "enum": [
            "Single Preview",
            "Multiple Previews",
            "Previews Only"
          ],
          "default": "Single Preview"
        },
        "piperMarkdown.enhanced.automaticallyShowPreviewOfMarkdownBeingEdited": {
          "description": "%piperMarkdown.enhanced.automaticallyShowPreviewOfMarkdownBeingEdited.description%",
          "default": false,
          "type": "boolean"
        },
        "piperMarkdown.enhanced.disableAutoPreviewForUriSchemes": {
          "markdownDescription": "%piperMarkdown.enhanced.disableAutoPreviewForUriSchemes.markdownDescription%",
          "default": [
            "vscode-notebook-cell"
          ],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "piperMarkdown.enhanced.disableAutoPreviewForFilePatterns": {
          "markdownDescription": "%piperMarkdown.enhanced.disableAutoPreviewForFilePatterns.markdownDescription%",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "piperMarkdown.enhanced.previewColorScheme": {
          "type": "string",
          "enum": [
            "selectedPreviewTheme",
            "systemColorScheme",
            "editorColorScheme"
          ],
          "default": "selectedPreviewTheme",
          "markdownEnumDescriptions": [
            "%piperMarkdown.enhanced.previewColorScheme.markdownEnumDescriptions.0%",
            "%piperMarkdown.enhanced.previewColorScheme.markdownEnumDescriptions.1%",
            "%piperMarkdown.enhanced.previewColorScheme.markdownEnumDescriptions.2%"
          ]
        },
        "piperMarkdown.enhanced.enableTypographer": {
          "description": "%piperMarkdown.enhanced.enableTypographer.description%",
          "default": false,
          "type": "boolean"
        },
        "piperMarkdown.enhanced.mathRenderingOption": {
          "description": "%piperMarkdown.enhanced.mathRenderingOption.description%",
          "default": "KaTeX",
          "type": "string",
          "enum": [
            "KaTeX",
            "MathJax",
            "None"
          ]
        },
        "piperMarkdown.enhanced.mathInlineDelimiters": {
          "description": "%piperMarkdown.enhanced.mathInlineDelimiters.description%",
