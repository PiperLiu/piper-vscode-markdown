    "customEditors": [
      {
        "viewType": "piper-markdown-enhanced",
        "displayName": "%customEditorPreviewDisplayName%",
        "selector": [
          {
            "filenamePattern": "*.{md,markdown,mdown,mkdn,mkd,rmd,qmd}"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "piperMarkdown.enhanced.openPreviewToTheSide",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "piperMarkdown.enhanced.openPreview",
        "key": "ctrl+shift+v",
        "mac": "cmd+shift+v",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "piperMarkdown.enhanced.openLockedPreviewToTheSide",
        "key": "ctrl+k shift+l",
        "mac": "cmd+k shift+l",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "piperMarkdown.enhanced.togglePreviewLock",
        "key": "ctrl+k ctrl+shift+l",
        "mac": "cmd+k cmd+shift+l",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "piperMarkdown.enhanced.runAllCodeChunks",
        "key": "ctrl+shift+enter",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "piperMarkdown.enhanced.runCodeChunk",
        "key": "shift+enter",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      },
      {
        "command": "piperMarkdown.enhanced.syncPreview",
        "key": "ctrl+shift+s",
        "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "piperMarkdown.enhanced.startCrossnoteServer",
          "when": "resourceLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/ && !isWeb",
          "group": "piper-markdown-enhanced"
        },
        {
          "command": "piperMarkdown.enhanced.stopCrossnoteServer",
          "when": "resourceLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/ && piperMarkdown.enhanced.crossnoteServerRunning && !isWeb",
          "group": "piper-markdown-enhanced"
        }
      ],
      "editor/context": [
        {
          "command": "piperMarkdown.enhanced.openPreviewToTheSide",
          "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/",
          "group": "piper-markdown-enhanced"
        },
        {
          "command": "piperMarkdown.enhanced.openGraphView",
          "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/",
          "group": "piper-markdown-enhanced"
        },
        {
          "command": "piperMarkdown.enhanced.startCrossnoteServer",
          "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/ && !isWeb",
          "group": "piper-markdown-enhanced"
        },
        {
          "command": "piperMarkdown.enhanced.stopCrossnoteServer",
          "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/ && piperMarkdown.enhanced.crossnoteServerRunning && !isWeb",
          "group": "piper-markdown-enhanced"
        }
      ],
      "editor/title": [
        {
          "command": "piperMarkdown.enhanced.openPreviewToTheSide",
          "when": "editorLangId =~ /^(markdown|quarto|prompt|instructions|chatagent|skill)$/",
          "group": "navigation"
        }
      ]
    }
  },
