        "title": "%piperMarkdown.enhanced.insertNewSlide.title%"
      },
      {
        "command": "piperMarkdown.enhanced.insertTable",
        "title": "%piperMarkdown.enhanced.insertTable.title%"
      },
      {
        "command": "piperMarkdown.enhanced.insertPagebreak",
        "title": "%piperMarkdown.enhanced.insertPagebreak.title%"
      },
      {
        "command": "piperMarkdown.enhanced.createTOC",
        "title": "%piperMarkdown.enhanced.createTOC.title%",
        "enablement": "!isWeb"
      },
      {
        "command": "piperMarkdown.enhanced.openConfigScript",
        "title": "%piperMarkdown.enhanced.openConfigScript.title%",
        "enablement": "!isWeb"
      },
      {
        "command": "piperMarkdown.enhanced.extendParser",
        "title": "%piperMarkdown.enhanced.extendParser.title%",
        "enablement": "!isWeb"
      },
      {
        "command": "piperMarkdown.enhanced.customizePreviewHtmlHead",
        "title": "%piperMarkdown.enhanced.customizePreviewHtmlHead.title%",
