{
  "name": "piper-markdown-enhanced",
  "displayName": "%displayName%",
  "version": "0.8.40",
  "description": "%description%",
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown"
  ],
  "bugs": {
    "url": "https://github.com/shd101wyy/vscode-markdown-preview-enhanced/issues"
  },
  "repository": "https://github.com/shd101wyy/vscode-markdown-preview-enhanced",
  "license": "NCSA",
  "contributors": [
    "shd101wyy",
    "kachkaev",
    "gabyx",
    "mavaddat"
  ],
  "publisher": "shd101wyy",
  "packageManager": "pnpm@10.28.0",
  "main": "./out/native/extension.js",
  "browser": "./out/web/extension.js",
  "l10n": "l10n/bundle.l10n.json",
  "scripts": {
    "build": "gulp copy-files && gulp clean-out && node build.js",
    "check:all": "pnpm check:eslint && pnpm check:prettier",
    "check:eslint": "eslint \"**/*\"",
    "check:prettier": "prettier --check \"**/*.*\"",
    "fix:all": "pnpm fix:eslint && pnpm fix:prettier",
    "fix:eslint": "eslint --fix \"**/*\"",
    "fix:prettier": "prettier --write \"**/*.*\"",
    "prepare": "husky",
    "run-in-browser": "node build.js --web-dev && concurrently \"vscode-test-web --browser none --extensionDevelopmentPath=. ${SERVE_DIR:-.}\" \"npx http-server ./crossnote -p 6789 --cors\"",
    "run-in-browser:watch": "node build.js --web-dev && concurrently \"vscode-test-web --browser none --extensionDevelopmentPath=. ${SERVE_DIR:-.}\" \"npx http-server ./crossnote -p 6789 --cors\" \"node build.js --watch\"",
    "run-in-vscode-dev": "npx serve --cors -l 5000 --ssl-cert $HOME/certs/localhost.pem --ssl-key $HOME/certs/localhost-key.pem",
    "test": "pnpm test:unit",
    "test:unit": "mocha --ui tdd --reporter spec test/find-fragment-target-line.test.js test/block-id-helpers.test.js test/rank-by-closeness.test.js test/current-preview-source.test.js test/preview-source-integration.test.js test/l10n-bundles.test.js test/native-runtime-compat.test.js test/crossnote-serve-output.test.js test/filesystem-root-warning.test.js test/custom-editor-options.test.js test/editor-associations.test.js test/custom-editor-single-preview.test.js test/trusted-script-roots.test.js test/piper-compatibility.test.js test/piper-api.test.js test/tikz-external.test.js test/config-execution-security.test.js test/crossnote-build-safety.test.js test/publishing.test.js test/publishing-parser-security.test.js test/publishing-progress.test.js",
    "vscode:prepublish": "pnpm install --frozen-lockfile && pnpm build",
    "watch": "gulp copy-files && gulp clean-out && node build.js --watch"
  },
  "contributes": {
    "commands": [
      {
        "command": "piperMarkdown.enhanced.openGraphView",
        "title": "%piperMarkdown.enhanced.openGraphView.title%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "piperMarkdown.enhanced.openPreviewToTheSide",
        "title": "%piperMarkdown.enhanced.openPreviewToTheSide.title%",
        "icon": {
          "light": "./media/preview-right-light.svg",
          "dark": "./media/preview-right-dark.svg"
        }
      },
      {
        "command": "piperMarkdown.enhanced.openPreview",
        "title": "%piperMarkdown.enhanced.openPreview.title%",
        "icon": {
          "light": "./media/preview-right-light.svg",
          "dark": "./media/preview-right-dark.svg"
        }
      },
      {
        "command": "piperMarkdown.enhanced.openLockedPreviewToTheSide",
        "title": "%piperMarkdown.enhanced.openLockedPreviewToTheSide.title%"
      },
      {
        "command": "piperMarkdown.enhanced.togglePreviewLock",
        "title": "%piperMarkdown.enhanced.togglePreviewLock.title%"
      },
      {
        "command": "piperMarkdown.enhanced.copyBlockReference",
        "title": "%piperMarkdown.enhanced.copyBlockReference.title%"
      },
      {
