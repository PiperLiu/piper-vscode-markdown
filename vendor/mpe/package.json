      },
      {
        "command": "piperMarkdown.enhanced.openConfigScriptInWorkspace",
        "title": "%piperMarkdown.enhanced.openConfigScriptInWorkspace.title%"
      },
      {
        "command": "piperMarkdown.enhanced.extendParserInWorkspace",
        "title": "%piperMarkdown.enhanced.extendParserInWorkspace.title%"
      },
      {
        "command": "piperMarkdown.enhanced.customizePreviewHtmlHeadInWorkspace",
        "title": "%piperMarkdown.enhanced.customizePreviewHtmlHeadInWorkspace.title%"
      },
      {
        "command": "piperMarkdown.enhanced.showUploadedImages",
        "title": "%piperMarkdown.enhanced.showUploadedImages.title%",
